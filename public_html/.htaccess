RewriteEngine On

# ─── Security Headers ─────────────────────────────────────────────────────
<IfModule mod_headers.c>
    # HSTS (6 months)
    Header always set Strict-Transport-Security "max-age=15768000; includeSubDomains"
    # Prevent MIME-type sniffing
    Header always set X-Content-Type-Options "nosniff"
    # Prevent clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"
    # Referrer policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # Permissions policy (unload=* required by the app shell)
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), unload=*"
    # Content Security Policy
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https: https://maps.gstatic.com https://maps.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; connect-src 'self' https:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; frame-src 'self' https://maps.google.com https://www.google.com; media-src 'self' data: blob:; worker-src 'self' blob:"
</IfModule>

# ─── Block leaked debug logs, backups and config files ────────────────────
# These rules MUST stay above the SPA fallback below, otherwise a request for
# e.g. /error_log would be rewritten to index.html and served the app instead
# of being rejected.
RewriteRule ^(error_log|.*\.(bak|old|orig|tmp|log|swp|save))$ - [F,L]
RewriteRule ^.*\.(env|config|sql|md|gitignore|cache)$ - [F,L]

# Prevent listing of hidden/system files.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Block sensitive files across the web root.
<FilesMatch "^(error_log|.*\.(bak|old|orig|tmp|log|swp|save|env|config|sql|md|gitignore|cache))$">
    Require all denied
</FilesMatch>

# Never allow direct access to the credential/config file.
# NOTE: env.json is intentionally NOT blocked here. It contains only public
# VITE_* branding/feature flags (no secrets) and the frontend bundle fetches it
# at startup; blocking it produced a 403 in the browser console.
<Files "config.php">
    Require all denied
</Files>

# ─── Block the nested legacy site copy (CRITICAL) ────────────────────────────
# public_html/public_html/ is a stale duplicate of the whole web root extracted
# from an old backup. Because it sits INSIDE the document root it is directly
# reachable at /public_html/... and serves UNHARDENED copies of setup.php and
# api/setup-test.php, which expose unauthenticated `test` / `migrate` / `fresh`
# (DROP DATABASE) / `saveenv` (overwrite config.php) actions. .htaccess cannot
# protect PHP execution, so the whole subtree must be denied here.
RewriteRule ^public_html(/|$) - [F,L]

# ─── Force HTTPS ───────────────────────────────────────────────────────────
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# ─── SPA Client-Side Routing ───────────────────────────────────────────────
# The frontend uses @tanstack/react-router with browser history, so deep links
# such as /login, /dashboard and /patients must be served index.html and
# resolved on the client. Without this rule LiteSpeed returns a hard 404 on
# refresh or direct navigation.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/api/
RewriteCond %{REQUEST_URI} !^/phpmyadmin/
RewriteRule ^ /index.html [L]

# ─── Compression ──────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml font/woff font/woff2
</IfModule>

# ─── Disable Directory Browsing / hide server signature ───────────────────
Options -Indexes
ServerSignature Off
ServerTokens Prod
# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php81” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php81 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
